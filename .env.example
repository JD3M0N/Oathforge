# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oathforge
# Used only by the service tests; the database is wiped by the tests
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oathforge_test

# Gemini (https://aistudio.google.com/apikey). Leave empty to play with template narration only.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_NARRATIVE=gemini-flash-latest

# AI budgets (checked before every call)
AI_USER_DAILY_CALLS=200
AI_USER_DAILY_TOKENS=200000
AI_GLOBAL_DAILY_CALLS=5000
AI_TIMEOUT_SECONDS=20

DEFAULT_LANGUAGE=es
